generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ── ENUMS ─────────────────────────────────────────────

enum UserRole {
  ADMIN
  ASSET_MANAGER
  DEPARTMENT_HEAD
  EMPLOYEE
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum AssetStatus {
  AVAILABLE
  ALLOCATED
  RESERVED
  UNDER_MAINTENANCE
  LOST
  RETIRED
  DISPOSED
}

enum AssetCondition {
  NEW
  GOOD
  FAIR
  POOR
  DAMAGED
}

enum AllocationStatus {
  ACTIVE
  RETURNED
  TRANSFERRED
  OVERDUE
}

enum TransferStatus {
  REQUESTED
  APPROVED
  REJECTED
}

enum BookingStatus {
  UPCOMING
  ONGOING
  COMPLETED
  CANCELLED
}

enum MaintenanceStatus {
  PENDING
  APPROVED
  REJECTED
  TECHNICIAN_ASSIGNED
  IN_PROGRESS
  RESOLVED
}

enum MaintenancePriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AuditCycleStatus {
  PLANNED
  IN_PROGRESS
  CLOSED
}

enum AuditItemResult {
  PENDING
  VERIFIED
  MISSING
  DAMAGED
}

enum NotificationType {
  ASSET_ASSIGNED
  MAINTENANCE_APPROVED
  MAINTENANCE_REJECTED
  BOOKING_CONFIRMED
  BOOKING_CANCELLED
  BOOKING_REMINDER
  TRANSFER_APPROVED
  OVERDUE_RETURN
  AUDIT_DISCREPANCY
  ROLE_CHANGED
}

// ── CORE ORG STRUCTURE ────────────────────────────────

model Department {
  id                 String       @id @default(uuid())
  name               String       @unique
  parentDepartmentId String?
  parentDepartment   Department?  @relation("DeptHierarchy", fields: [parentDepartmentId], references: [id])
  childDepartments   Department[] @relation("DeptHierarchy")
  headUserId         String?      @unique
  head               User?        @relation("DepartmentHead", fields: [headUserId], references: [id])
  status             UserStatus   @default(ACTIVE)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  employees          User[]             @relation("DepartmentEmployees")
  allocations        AssetAllocation[]  @relation("DepartmentAllocations")
  bookings           Booking[]
  auditCycles        AuditCycle[]

  @@index([parentDepartmentId])
}

model User {
  id           String     @id @default(uuid())
  name         String
  email        String     @unique
  passwordHash String
  role         UserRole   @default(EMPLOYEE)
  departmentId String?
  department   Department? @relation("DepartmentEmployees", fields: [departmentId], references: [id])
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  headOfDepartment    Department?             @relation("DepartmentHead")
  assetsRegistered    Asset[]                 @relation("RegisteredBy")
  allocationsReceived AssetAllocation[]       @relation("AllocatedToUser")
  allocationsMade     AssetAllocation[]       @relation("AllocatedByUser")
  transfersRequested  AssetTransferRequest[]  @relation("RequestedBy")
  transfersApproved   AssetTransferRequest[]  @relation("ApprovedBy")
  bookings            Booking[]               @relation("BookedBy")
  maintenanceRaised   MaintenanceRequest[]    @relation("RaisedBy")
  maintenanceApproved MaintenanceRequest[]    @relation("MaintenanceApprovedBy")
  auditCyclesCreated  AuditCycle[]            @relation("CreatedBy")
  auditsAssigned      AuditCycleAuditor[]
  auditItemsVerified  AuditItem[]
  notifications       Notification[]
  activityLogs        ActivityLog[]
  refreshTokens       RefreshToken[]

  @@index([departmentId])
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  tokenHash String
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

// ── ASSET MASTER DATA ─────────────────────────────────

model AssetCategory {
  id                 String   @id @default(uuid())
  name               String   @unique
  description        String?
  customFieldsSchema Json?    // e.g. [{ "key": "warrantyMonths", "type": "number", "label": "Warranty (months)" }]
  createdAt          DateTime @default(now())

  assets             Asset[]
}

model Asset {
  id                String         @id @default(uuid())
  assetTag          String         @unique          // AF-0001, server-generated
  name              String
  categoryId        String
  category          AssetCategory  @relation(fields: [categoryId], references: [id])
  serialNumber      String?        @unique
  acquisitionDate   DateTime?
  acquisitionCost   Decimal?       @db.Decimal(12, 2)
  condition         AssetCondition @default(GOOD)
  location          String?
  isBookable        Boolean        @default(false)
  status            AssetStatus    @default(AVAILABLE)
  qrCodeUrl         String?
  registeredById    String
  registeredBy      User           @relation("RegisteredBy", fields: [registeredById], references: [id])
  customFieldValues Json?          // keyed against AssetCategory.customFieldsSchema
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  documents           AssetDocument[]
  allocations         AssetAllocation[]
  transferRequests    AssetTransferRequest[]
  bookings            Booking[]
  maintenanceRequests MaintenanceRequest[]
  auditItems          AuditItem[]

  @@index([status])
  @@index([categoryId])
  @@index([location])
}

model AssetDocument {
  id         String   @id @default(uuid())
  assetId    String
  asset      Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  fileUrl    String
  fileType   String   // 'photo' | 'invoice' | 'manual'
  uploadedAt DateTime @default(now())

  @@index([assetId])
}

// ── ALLOCATION & TRANSFER ─────────────────────────────

model AssetAllocation {
  id                      String            @id @default(uuid())
  assetId                 String
  asset                   Asset             @relation(fields: [assetId], references: [id])
  allocatedToUserId       String?
  allocatedToUser         User?             @relation("AllocatedToUser", fields: [allocatedToUserId], references: [id])
  allocatedToDepartmentId String?
  allocatedToDepartment   Department?       @relation("DepartmentAllocations", fields: [allocatedToDepartmentId], references: [id])
  allocatedById           String
  allocatedBy             User              @relation("AllocatedByUser", fields: [allocatedById], references: [id])
  expectedReturnDate      DateTime?
  actualReturnDate        DateTime?
  status                  AllocationStatus  @default(ACTIVE)
  conditionNoteOut        String?
  conditionNoteIn         String?
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt

  transferRequestsFrom    AssetTransferRequest[] @relation("FromAllocation")

  @@index([assetId, status])
  @@index([allocatedToUserId])
  @@index([expectedReturnDate])   // overdue sweep query
}

model AssetTransferRequest {
  id                          String          @id @default(uuid())
  assetId                     String
  asset                       Asset           @relation(fields: [assetId], references: [id])
  fromAllocationId            String
  fromAllocation              AssetAllocation @relation("FromAllocation", fields: [fromAllocationId], references: [id])
  requestedById               String
  requestedBy                 User            @relation("RequestedBy", fields: [requestedById], references: [id])

  // Destination — XOR pair
  requestedToUserId           String?
  requestedToDepartmentId     String?

  // Snapshot fields, computed once by resolveApprover() at creation time.
  sourceDepartmentId          String?
  destinationDepartmentId     String?
  requiresAssetManagerApproval Boolean        @default(false)

  status                      TransferStatus  @default(REQUESTED)
  approvedById                String?
  approvedBy                  User?           @relation("ApprovedBy", fields: [approvedById], references: [id])
  notes                       String?
  requestedAt                 DateTime        @default(now())
  resolvedAt                  DateTime?

  @@index([assetId, status])
  @@index([requiresAssetManagerApproval, status])
}

// ── BOOKING ────────────────────────────────────────────

model Booking {
  id           String        @id @default(uuid())
  assetId      String
  asset        Asset         @relation(fields: [assetId], references: [id])
  bookedById   String
  bookedBy     User          @relation("BookedBy", fields: [bookedById], references: [id])
  departmentId String?
  department   Department?   @relation(fields: [departmentId], references: [id])
  startTime    DateTime
  endTime      DateTime
  status       BookingStatus @default(UPCOMING)
  cancelReason String?
  createdAt    DateTime      @default(now())

  @@index([assetId, startTime, endTime])
}

// ── MAINTENANCE ────────────────────────────────────────

model MaintenanceRequest {
  id               String              @id @default(uuid())
  assetId          String
  asset            Asset               @relation(fields: [assetId], references: [id])
  raisedById       String
  raisedBy         User                @relation("RaisedBy", fields: [raisedById], references: [id])
  issueDescription String
  priority         MaintenancePriority @default(MEDIUM)
  photoUrl         String?
  status           MaintenanceStatus   @default(PENDING)
  approvedById     String?
  approvedBy       User?               @relation("MaintenanceApprovedBy", fields: [approvedById], references: [id])
  technicianName   String?
  resolutionNotes  String?
  resolvedAt       DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@index([assetId, status])
}

// ── AUDIT ──────────────────────────────────────────────

model AuditCycle {
  id                String           @id @default(uuid())
  name              String
  scopeDepartmentId String?
  scopeDepartment   Department?      @relation(fields: [scopeDepartmentId], references: [id])
  scopeLocation     String?
  startDate         DateTime
  endDate           DateTime
  status            AuditCycleStatus @default(PLANNED)
  createdById       String
  createdBy         User             @relation("CreatedBy", fields: [createdById], references: [id])
  closedAt          DateTime?
  createdAt         DateTime         @default(now())

  auditors          AuditCycleAuditor[]
  items             AuditItem[]
}

model AuditCycleAuditor {
  auditCycleId String
  auditCycle   AuditCycle @relation(fields: [auditCycleId], references: [id])
  auditorId    String
  auditor      User       @relation(fields: [auditorId], references: [id])

  @@id([auditCycleId, auditorId])
}

model AuditItem {
  id           String          @id @default(uuid())
  auditCycleId String
  auditCycle   AuditCycle      @relation(fields: [auditCycleId], references: [id])
  assetId      String
  asset        Asset           @relation(fields: [assetId], references: [id])
  result       AuditItemResult @default(PENDING)
  notes        String?
  verifiedById String?
  verifiedBy   User?           @relation(fields: [verifiedById], references: [id])
  verifiedAt   DateTime?

  @@unique([auditCycleId, assetId])   // one verification row per asset per cycle
}

// ── NOTIFICATIONS & LOGGING ────────────────────────────

model Notification {
  id                String           @id @default(uuid())
  userId            String
  user              User             @relation(fields: [userId], references: [id])
  type              NotificationType
  message           String
  relatedEntityType String?
  relatedEntityId   String?
  isRead            Boolean          @default(false)
  createdAt         DateTime         @default(now())

  @@index([userId, isRead])
}

model ActivityLog {
  id         String   @id @default(uuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String
  entityType String
  entityId   String
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([userId])
}
